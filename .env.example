# DeepSeek is the ONLY cloud AI provider for ClassApp. No Gemini or alternate provider.
# Read exclusively by the server runtime. Never exposed to the browser or client bundles.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# Verified model IDs (checked 2026-10-23): deepseek-flash | deepseek-v4-pro
# deepseek-flash is the lowest-cost option and is served by DeepSeek-V4.1-Flash-1017.
# Any other value fails loudly with a 503 instead of silently switching models.
DEEPSEEK_MODEL="deepseek-flash"

# Optional: override the API base URL (defaults to https://api.deepseek.com)
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Neon Postgres — accounts, roles, file records, usage counters.
# Create a project at https://console.neon.tech and copy the pooled connection string.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Backblaze B2 (S3-compatible object storage for file contents).
# Endpoint looks like https://s3.<region>.backblazeb2.com — the region in the
# endpoint and B2_REGION must match the bucket's own region (us-east-005 here).
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
B2_REGION="us-east-005"
B2_KEY_ID="MY_B2_KEY_ID"
B2_APPLICATION_KEY="MY_B2_APPLICATION_KEY"
B2_BUCKET_NAME="classapp-vault"

# The public URL where this app is hosted. Provided automatically by the runtime in AI Studio.
APP_URL="MY_APP_URL"
